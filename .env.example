# Copy to .env and edit. Never commit .env (gitignored).

# DRY = generates PJL bundle to tmp/jobs/, never opens socket to printer
# LIVE = sends to printer at PRESS_PRINTER_HOST:PRESS_PRINTER_RAW_PORT
# DO NOT set to live until docs/HARDWARE-GATES.md is fully signed off.
PRESS_SAFE_PRINT_MODE=dry

PRESS_PRINTER_HOST=172.16.1.149
PRESS_PRINTER_RAW_PORT=9100

PRESS_BIND_HOST=127.0.0.1
PRESS_BIND_PORT=5273
